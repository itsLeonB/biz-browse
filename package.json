{
  "name": "biz-browse",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3107",
    "build": "vite build",
    "migrate": "node-pg-migrate up --migrations-dir db --migration-file-language sql",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "format": "oxfmt --write src vite.config.ts tests",
    "format:check": "oxfmt --check src vite.config.ts tests",
    "lint": "oxlint src vite.config.ts tests scripts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@clerk/tanstack-react-start": "^1.0.0",
    "@tanstack/react-router": "^1.0.0",
    "@tanstack/react-start": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.74.0",
    "postgres": "^4.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "axe-core": "^4.14.1",
    "node-pg-migrate": "9.0.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.0",
    "vite": "^8.0.0",
    "wrangler": "^4.0.0"
  }
}
