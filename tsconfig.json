{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "src",
    "worker-configuration.d.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "tests",
    "scripts",
    ".agents/skills/shadcn/scripts/showcase-coverage.ts"
  ]
}
